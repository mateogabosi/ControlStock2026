@page "/listaproducto"
@using ControlStock.Shared.DTOs
@using ClienteStock.Cliente.Pages.Shared
@using ClienteStock.Cliente.Services
@inject ProductoService ProductoService
@inject IJSRuntime JS

<PageTitle>Gestión de Productos</PageTitle>

<div class="prod-page">

    <!-- ===== Encabezado ===== -->
    <header class="prod-header">
        <div class="prod-heading">
            <span class="prod-eyebrow">Inventario</span>
            <h1 class="prod-title">Gestión de Productos</h1>
            <p class="prod-subtitle">Cargá, revisá y controlá el stock de tu kiosco en un solo lugar.</p>
        </div>

        <div class="prod-stats" aria-label="Resumen del inventario">
            <div class="prod-stat">
                <span class="prod-stat-label">Productos</span>
                <span class="prod-stat-value">@listaProductos.Count</span>
            </div>
            <div class="prod-stat @(ProductosConStockBajo > 0 ? "prod-stat-danger" : null)">
                <span class="prod-stat-label">Stock bajo</span>
                <span class="prod-stat-value">@ProductosConStockBajo</span>
            </div>
        </div>
    </header>

    <!-- ===== Alertas ===== -->
    @if (!string.IsNullOrEmpty(mensajeError))
    {
        <div class="prod-alert prod-alert-error" role="alert">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                 stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <circle cx="12" cy="12" r="10" />
                <path d="M12 8v4" />
                <path d="M12 16h.01" />
            </svg>
            <span>@mensajeError</span>
            <button type="button" class="prod-alert-close" aria-label="Cerrar mensaje"
                    @onclick="() => mensajeError = null">&times;</button>
        </div>
    }
    @if (!string.IsNullOrEmpty(mensajeExito))
    {
        <div class="prod-alert prod-alert-success" role="status">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                 stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14" />
                <path d="M22 4L12 14.01l-3-3" />
            </svg>
            <span>@mensajeExito</span>
            <button type="button" class="prod-alert-close" aria-label="Cerrar mensaje"
                    @onclick="() => mensajeExito = null">&times;</button>
        </div>
    }

    <div class="prod-layout">

        <!-- ===== Panel de registro ===== -->
        <section class="prod-card prod-card-form" aria-labelledby="prod-form-title">
            <div class="prod-card-head">
                <div class="prod-card-icon prod-card-icon-green" aria-hidden="true">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                         stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <circle cx="12" cy="12" r="10" />
                        <path d="M12 8v8" />
                        <path d="M8 12h8" />
                    </svg>
                </div>
                <div>
                    <h2 id="prod-form-title" class="prod-card-title">Nuevo producto</h2>
                    <p class="prod-card-sub">Completá los datos para agregarlo al inventario.</p>
                </div>
            </div>

            <EditForm Model="productoNuevo"
                      OnValidSubmit="GuardarProducto"
                      OnInvalidSubmit="MostrarErroresValidacion">
                <DataAnnotationsValidator />

                <div class="prod-validation-summary">
                    <ValidationSummary />
                </div>

                <div class="prod-form-grid">
                    <div class="prod-field prod-field-full">
                        <label class="prod-label" for="prod-nombre">Nombre del producto</label>
                        <InputText id="prod-nombre"
                                   class="prod-input"
                                   @bind-Value="productoNuevo.Nombre"
                                   placeholder="Ej. Coca Cola 1.5L"
                                   autocomplete="off" />
                    </div>

                    <div class="prod-field prod-field-full">
                        <label class="prod-label" for="prod-descripcion">Descripción</label>
                        <InputText id="prod-descripcion"
                                   class="prod-input"
                                   @bind-Value="productoNuevo.Descripcion"
                                   placeholder="Ej. Gaseosa sabor cola, botella de 1.5 L"
                                   autocomplete="off" />
                    </div>

                    <div class="prod-field">
                        <label class="prod-label" for="prod-precio">Precio</label>
                        <div class="prod-input-group">
                            <span class="prod-prefix" aria-hidden="true">$</span>
                            <InputNumber id="prod-precio"
                                         class="prod-input"
                                         @bind-Value="productoNuevo.Precio"
                                         step="0.01"
                                         min="0"
                                         placeholder="0.00" />
                        </div>
                    </div>

                    <div class="prod-field">
                        <label class="prod-label" for="prod-stock-actual">Stock actual</label>
                        <InputNumber id="prod-stock-actual"
                                     class="prod-input"
                                     @bind-Value="productoNuevo.StockActual"
                                     min="0"
                                     placeholder="0" />
                    </div>

                    <div class="prod-field">
                        <label class="prod-label" for="prod-stock-minimo">Stock mínimo</label>
                        <InputNumber id="prod-stock-minimo"
                                     class="prod-input"
                                     @bind-Value="productoNuevo.StockMinimo"
                                     min="0"
                                     placeholder="0" />
                    </div>
                </div>

                <BotonPersonalizado ClaseVariante="prod-btn prod-btn-save"
                                    Type="submit"
                                    Disabled="@guardando">
                    <ChildContent>
                        @if (guardando)
                        {
                            <span class="prod-spinner" aria-hidden="true"></span>
                            <span>Guardando...</span>
                        }
                        else
                        {
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                 stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                <path d="M5 12l5 5L20 7" />
                            </svg>
                            <span>Guardar producto</span>
                        }
                    </ChildContent>
                </BotonPersonalizado>
            </EditForm>
        </section>

        <!-- ===== Panel de inventario ===== -->
        <section class="prod-card prod-card-table" aria-labelledby="prod-table-title">
            <div class="prod-card-head prod-card-head-row">
                <div class="prod-card-head">
                    <div class="prod-card-icon prod-card-icon-indigo" aria-hidden="true">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                             stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z" />
                            <path d="M3.27 6.96L12 12.01l8.73-5.05" />
                            <path d="M12 22.08V12" />
                        </svg>
                    </div>
                    <div>
                        <h2 id="prod-table-title" class="prod-card-title">Inventario</h2>
                        <p class="prod-card-sub">
                            @(listaProductos.Count == 1
                                ? "1 producto registrado"
                                : $"{listaProductos.Count} productos registrados")
                        </p>
                    </div>
                </div>

                <BotonPersonalizado ClaseVariante="prod-btn prod-btn-bulk"
                                    Type="button"
                                    Disabled="@(eliminando || eliminandoId.HasValue || !listaProductos.Any())"
                                    OnClick="ConfirmarEliminarTodos"
                                    title="Eliminar todos los productos">
                    <ChildContent>
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                             stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <path d="M3 6h18" />
                            <path d="M8 6V4a1 1 0 0 1 1-1h6a1 1 0 0 1 1 1v2" />
                            <path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6" />
                            <path d="M10 11v6" />
                            <path d="M14 11v6" />
                        </svg>
                        <span>Eliminar productos</span>
                    </ChildContent>
                </BotonPersonalizado>
            </div>

            <div class="prod-table-wrap">
                <table class="prod-table">
                    <thead>
                        <tr>
                            <th scope="col">Producto</th>
                            <th scope="col" class="prod-col-num">Precio</th>
                            <th scope="col" class="prod-col-num">Stock</th>
                            <th scope="col" class="prod-col-actions">
                                <span class="visually-hidden">Acciones</span>
                            </th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (listaProductos.Any())
                        {
                            @foreach (var prod in listaProductos)
                            {
                                <tr class="@(EsStockBajo(prod) ? "prod-row-low" : null)">
                                    <td>
                                        <div class="prod-product">
                                            <span class="prod-avatar" aria-hidden="true">@InicialProducto(prod.Nombre)</span>
                                            <div class="prod-product-info">
                                                <span class="prod-product-name">
                                                    @prod.Nombre
                                                    <span class="prod-id">#@prod.Id</span>
                                                </span>
                                                <span class="prod-product-desc">
                                                    @(string.IsNullOrWhiteSpace(prod.Descripcion)
                                                        ? "Sin descripción"
                                                        : prod.Descripcion)
                                                </span>
                                            </div>
                                        </div>
                                    </td>
                                    <td class="prod-col-num prod-price">$@prod.Precio.ToString("N2")</td>
                                    <td class="prod-col-num">
                                        <span class="prod-badge @(EsStockBajo(prod) ? "prod-badge-low" : "prod-badge-ok")">
                                            @prod.StockActual
                                        </span>
                                        <span class="prod-min">mín. @prod.StockMinimo</span>
                                    </td>
                                    <td class="prod-col-actions">
                                        <BotonPersonalizado ClaseVariante="prod-btn prod-btn-icon"
                                                            Type="button"
                                                            Disabled="@(eliminando || eliminandoId.HasValue)"
                                                            OnClick="() => ConfirmarEliminar(prod)"
                                                            title="@("Eliminar " + prod.Nombre)"
                                                            aria-label="@("Eliminar " + prod.Nombre)">
                                            <ChildContent>
                                                @if (eliminandoId == prod.Id)
                                                {
                                                    <span class="prod-spinner prod-spinner-dark" aria-hidden="true"></span>
                                                }
                                                else
                                                {
                                                    <svg width="17" height="17" viewBox="0 0 24 24" fill="none"
                                                         stroke="currentColor" stroke-width="2"
                                                         stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                                        <path d="M3 6h18" />
                                                        <path d="M8 6V4a1 1 0 0 1 1-1h6a1 1 0 0 1 1 1v2" />
                                                        <path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6" />
                                                        <path d="M10 11v6" />
                                                        <path d="M14 11v6" />
                                                    </svg>
                                                }
                                            </ChildContent>
                                        </BotonPersonalizado>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="4">
                                    <div class="prod-empty">
                                        <svg width="44" height="44" viewBox="0 0 24 24" fill="none"
                                             stroke="currentColor" stroke-width="1.5"
                                             stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                            <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z" />
                                            <path d="M3.27 6.96L12 12.01l8.73-5.05" />
                                            <path d="M12 22.08V12" />
                                        </svg>
                                        <p class="prod-empty-title">Todavía no hay productos</p>
                                        <p class="prod-empty-text">Usá el formulario de la izquierda para cargar el primero.</p>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </section>
    </div>
</div>

@code {
    private ProductoDTO productoNuevo = new();
    private List<ProductoListadoDTO> listaProductos = new();
    private bool guardando = false;
    private bool eliminando = false;
    private int? eliminandoId;
    private string? mensajeError;
    private string? mensajeExito;

    private int ProductosConStockBajo => listaProductos.Count(EsStockBajo);

    private static bool EsStockBajo(ProductoListadoDTO producto)
        => producto.StockActual <= producto.StockMinimo;

    private static string InicialProducto(string? nombre)
        => string.IsNullOrWhiteSpace(nombre) ? "?" : nombre.Trim()[0].ToString().ToUpperInvariant();

    protected override async Task OnInitializedAsync()
    {
        await CargarProductos();
    }

    private async Task CargarProductos()
    {
        try
        {
            listaProductos = await ProductoService.ObtenerTodosAsync();
        }
        catch (Exception ex)
        {
            mensajeError = $"No se pudieron cargar los productos: {ex.Message}";
        }
    }

    private void MostrarErroresValidacion()
    {
        mensajeExito = null;
        mensajeError = "Revisá los datos del formulario: hay campos inválidos.";
    }

    private async Task GuardarProducto()
    {
        if (guardando)
        {
            return;
        }

        guardando = true;
        mensajeError = null;
        mensajeExito = null;

        try
        {
            var creado = await ProductoService.CrearAsync(productoNuevo);

            mensajeExito = $"Producto \"{creado.Nombre}\" guardado con éxito.";
            productoNuevo = new ProductoDTO(); // Limpia el formulario
            await CargarProductos();           // Recarga la tabla automáticamente
        }
        catch (HttpRequestException ex)
        {
            mensajeError = $"No se pudo guardar el producto: {ex.Message}";
        }
        catch (Exception ex)
        {
            mensajeError = $"Error inesperado: {ex.Message}";
        }
        finally
        {
            guardando = false;
        }
    }

    private async Task ConfirmarEliminar(ProductoListadoDTO producto)
    {
        if (eliminando || eliminandoId.HasValue)
        {
            return;
        }

        var confirmado = await JS.InvokeAsync<bool>(
            "confirm",
            $"¿Estás seguro de que deseas eliminar el producto \"{producto.Nombre}\"?");

        if (!confirmado)
        {
            return;
        }

        eliminandoId = producto.Id;
        mensajeError = null;
        mensajeExito = null;

        try
        {
            await ProductoService.EliminarAsync(producto.Id);

            mensajeExito = $"Producto \"{producto.Nombre}\" eliminado correctamente.";
            await CargarProductos(); // Recarga la tabla automáticamente
        }
        catch (HttpRequestException ex)
        {
            mensajeError = $"No se pudo eliminar el producto: {ex.Message}";
        }
        catch (Exception ex)
        {
            mensajeError = $"Error inesperado al eliminar el producto: {ex.Message}";
        }
        finally
        {
            eliminandoId = null;
        }
    }

    private async Task ConfirmarEliminarTodos()
    {
        if (eliminando || eliminandoId.HasValue)
        {
            return;
        }

        var confirmado = await JS.InvokeAsync<bool>(
            "confirm",
            "¿Estás seguro de que deseas eliminar todos los productos?");

        if (!confirmado)
        {
            return;
        }

        eliminando = true;
        mensajeError = null;
        mensajeExito = null;

        try
        {
            var eliminados = await ProductoService.EliminarTodosAsync();

            listaProductos.Clear(); // La tabla queda vacía inmediatamente
            mensajeExito = eliminados > 0
                ? $"Se eliminaron {eliminados} productos correctamente."
                : "No había productos para eliminar.";

            await CargarProductos(); // Sincroniza con el servidor
        }
        catch (HttpRequestException ex)
        {
            mensajeError = $"No se pudieron eliminar los productos: {ex.Message}";
        }
        catch (Exception ex)
        {
            mensajeError = $"Error inesperado al eliminar los productos: {ex.Message}";
        }
        finally
        {
            eliminando = false;
        }
    }
}
